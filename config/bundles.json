  "presets": [
    { "id": "anchored-standard", "source": "upstream/dsh-anchored-standard/preset", "version": "vendored", "note": "用户指定必装；测试基线 rc.5 47f9438 与本项目一致；绑定 pro 模型族", "model": "pro" },
    { "id": "zero-anchored-standard", "source": "upstream/dsh-anchored-standard/zero-anchored-standard", "version": "vendored", "model": "pro" },
    { "id": "whoami-standard", "source": "upstream/dsh-anchored-standard/whoami-standard", "version": "vendored", "model": "pro" },
    { "id": "router-standard", "source": "upstream/dsh-routing-suite/preset/preset", "version": "0.1.1", "note": "用户指定必装；思维模式路由预设；绑定 flash 模型族", "model": "flash" }
  ],
  "modelPresetLink": {
    "plugin": "@dsh-whale/model-preset-link",
    "autoSwitch": true,
    "toggleable": true,
    "note": "自研插件（T6）：autoSwitch=true 时 client 监听 ctx.modelDirectories 按会话模型切预设（blank 自动选，已开跑会话提示）；toggleable=设置页/启动器提供一键开关，关掉即恢复手动选预设，插件本身也可整体移除（可插拔性总纲）",
    "families": { "flash": ["router-standard"], "pro": ["anchored-standard", "zero-anchored-standard", "whoami-standard"] },
    "pluginStack": { "flash": ["dsh-super-injector"], "pro": [] },
    "modelPatterns": { "flash": "/flash/i", "pro": "/pro/i" }
  }
}
